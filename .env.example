# ---------------------------------------------------------------------------
# CloudCleaner environment template
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored. Never commit real credentials.
# Backend reads this file via agent/cloudcleaner/config.py.
# Do NOT prefix any of these with NEXT_PUBLIC_ — that exposes them to the browser.
# ---------------------------------------------------------------------------

# --- Frontend → agent wiring -----------------------------------------------
# Where the Next.js API route reaches the Python agent (main.py serves :8123).
AGENT_URL=http://localhost:8123

# --- LLM: Groq (CloudCleaner's reasoning model) ----------------------------
# Free key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- LLM: OpenAI -----------------------------------------------------------
# Only needed by the CopilotKit starter agent in agent/src/.
# CloudCleaner itself does not use it. Leave blank if you are not running the demo.
OPENAI_API_KEY=

# --- AWS -------------------------------------------------------------------
# From the Innovation Sandbox access portal → Access keys.
# MUST be uppercase: boto3 only reads these exact names.
# Session keys EXPIRE EVERY 12 HOURS — re-login to the portal and paste new ones.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# --- GitHub ----------------------------------------------------------------
# Fine-grained PAT, read-only. Scopes needed: Contents, Pull requests, Actions (read).
GITHUB_TOKEN=
GITHUB_REPO=

# --- Slack -----------------------------------------------------------------
# For the human-in-the-loop approval step.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=

# --- CopilotKit Intelligence (optional, starter template only) -------------
# COPILOTKIT_LICENSE_TOKEN=
# INTELLIGENCE_API_URL=http://localhost:4201
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4401
# CPK_INTELLIGENCE_API_KEY=

# --- CloudCleaner runtime flags --------------------------------------------
# fixture = run entirely offline against agent/cloudcleaner/fixtures/demo.py
CLOUDCLEANER_PROVIDER=aws
# true = plan and log everything, change nothing in AWS
CLOUDCLEANER_DRY_RUN=true
# false = rules-only, no resource metadata leaves the machine
CLOUDCLEANER_AI_ENABLED=true
METRIC_WINDOW_DAYS=7
# Where the database and reasoning log are written. Defaults to output/ beside
# this file, or ~/.cloudcleaner when installed rather than run from a checkout.
CLOUDCLEANER_DATA_DIR=
# Use a specific .env instead of letting the agent search for one.
CLOUDCLEANER_ENV_FILE=
# Point boto3 at LocalStack instead of real AWS
AWS_ENDPOINT_URL=
